# Copy to .env for local dev (never commit .env).
DAYFLOW_TOKEN=change-me                 # shared bearer token the extension sends
GOOGLE_API_KEY=                         # local dev: Gemini API key (GOOGLE_GENAI_USE_ENTERPRISE=0)
GOOGLE_GENAI_USE_ENTERPRISE=0           # 1 on Cloud Run (Vertex via ADC)
GOOGLE_CLOUD_PROJECT=dayflow-agentic
GOOGLE_CLOUD_LOCATION=global
DAYFLOW_FIRESTORE=0                     # 1 → Firestore sessions + config (ADC required)
PUBSUB_TOPIC=dayflow-jobs
PUBSUB_PUSH_SA=pubsub-invoker@dayflow-agentic.iam.gserviceaccount.com   # OIDC identity of push requests
CRON_INVOKER_SA=scheduler-invoker@dayflow-agentic.iam.gserviceaccount.com
OIDC_AUDIENCE=                          # defaults to the request URL
PUBSUB_VERIFY=1                         # 0 = skip OIDC checks (local only; ignored on Cloud Run)
DAYFLOW_BUCKET=dayflow-agentic-vault    # gs:// sources the worker may fetch
GITHUB_TOKEN=                           # enables the GitHub MCP connector
LINEAR_API_KEY=                         # enables the Linear MCP connector
