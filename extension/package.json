{
  "name": "dayflow-extension",
  "description": "Dayflow \u2014 your student ops agent, living in Chrome",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "zip:store": "DAYFLOW_STORE_BUILD=1 wxt zip",
    "icons": "node ../docs/store/scripts/make-icons.mjs",
    "screenshots": "node ../docs/store/scripts/screenshots.mjs",
    "build:store": "DAYFLOW_STORE_BUILD=1 wxt build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
